<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- A per-user MSI for radial-paste. Built with the WiX 3.x toolset, e.g.
       cargo install cargo-wix && cargo wix
       (or candle + light directly). Not wired into CI; code-signing the MSI and the exe
       happens outside of this file - see README, "Packaging". -->
  <Product Id="*"
           Name="radial-paste"
           Language="1033"
           Version="0.1.0"
           Manufacturer="radial-paste"
           UpgradeCode="de972e4c-727a-4747-b138-6ba19215487b">
    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perUser"
             Description="Hold a hotkey, flick toward a snippet, let go, and it is pasted."
             Comments="radial-paste settings and application" />
    <MajorUpgrade AllowDowngrades="no"
                  DowngradeErrorMessage="A newer version of radial-paste is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\crates\desktop\assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Feature Id="Main" Title="radial-paste" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="radial-paste">
          <Component Id="MainExecutable" Guid="515e53a3-1e05-4249-8a6f-d036b65e5b91">
            <File Id="RadialPasteExe"
                  Name="radial-paste.exe"
                  Source="..\target\release\radial-paste.exe"
                  KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
  </Product>
</Wix>
